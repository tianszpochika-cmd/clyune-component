# Copy to .env for docker compose / local cargo run
POSTGRES_USER=clyune
POSTGRES_PASSWORD=clyune_dev_change_me
POSTGRES_DB=clyune_component
POSTGRES_PORT=5432
POSTGRES_MEM_LIMIT=512m
API_PORT=8080
API_MEM_LIMIT=256m

# Local `cargo run` (when Postgres is up via compose):
DATABASE_URL=postgres://clyune:clyune_dev_change_me@127.0.0.1:5432/clyune_component
PORT=8080
REGISTRY_PATH=backend/data/registry.json
STATIC_DIR=frontend/dist
RUST_LOG=clyune_component=info,tower_http=info,sqlx=warn

# Alternative: use an existing MySQL later (not wired in v1 code — prefer Postgres).
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/clyune_component
