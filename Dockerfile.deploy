# Production image: frontend dist prebuilt on CI/box; only compile Rust here.
FROM rust:1.85-bookworm AS be
WORKDIR /be
ENV CARGO_BUILD_JOBS=2
COPY backend/Cargo.toml backend/Cargo.lock ./
RUN mkdir src && echo 'fn main(){}' > src/main.rs && cargo build --release && rm -rf src target/release/deps/clyune_component* target/release/clyune-component*
COPY backend/ ./
RUN touch src/main.rs && cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=be /be/target/release/clyune-component /app/clyune-component
COPY --from=be /be/migrations /app/migrations
COPY --from=be /be/data /app/data
COPY frontend/dist /app/frontend/dist
ENV REGISTRY_PATH=/app/data/registry.json
ENV STATIC_DIR=/app/frontend/dist
EXPOSE 8080
CMD ["/app/clyune-component"]
